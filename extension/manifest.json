{
  "manifest_version": 3,
  "name": "Rivendo per Vinted",
  "version": "0.1.0",
  "description": "Compila l'annuncio Vinted con i dati preparati da Rivendo. Non pubblica mai automaticamente.",
  "permissions": ["clipboardRead"],
  "host_permissions": ["https://www.vinted.it/*", "https://www.vinted.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.vinted.it/*", "https://www.vinted.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
