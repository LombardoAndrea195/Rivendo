# Copia in .env.local (sviluppo) e in .env.production.local (pubblicazione con `npm run deploy`).
# Valori da: Appwrite Console → il tuo progetto → Overview (Project ID e API Endpoint).
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# Metodi di accesso SSO mostrati nella pagina di login, separati da virgola: google, apple, microsoft.
# Il link via email è sempre disponibile.
VITE_AUTH_PROVIDERS=google

# Dati pubblici del titolare, richiesti per completare policy e schede degli store.
# Questi valori sono incorporati nel sito: non inserire segreti o credenziali.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_VAT_NUMBER=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
