# Copia questo file in .env.local (sviluppo) o inserisci le stesse variabili su Vercel (produzione).
# Valori da: Supabase → Project Settings → API Keys / Data API.
VITE_SUPABASE_URL=https://IL-TUO-PROGETTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Metodi di accesso SSO mostrati nella pagina di login, separati da virgola: google, apple, azure (Microsoft).
# Il link via email è sempre disponibile.
VITE_AUTH_PROVIDERS=google
