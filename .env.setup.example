# Copia in .env.setup e compila: serve SOLO allo script `npm run appwrite:setup`, gira sul tuo computer.
# La API key è segreta: non metterla mai in variabili VITE_ né nel repository.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Solo per Appwrite self-hosted: indirizzo con cui la function raggiunge l'API dall'interno di Docker.
# APPWRITE_FUNCTION_INTERNAL_ENDPOINT=http://appwrite/v1
