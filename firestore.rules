rules_version = '2';

// Ogni utente legge e scrive solo i propri dati: users/{uid} (impostazioni) e users/{uid}/items/{itemId}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
