{
  "name": "reseller-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "appwrite:setup": "node --env-file-if-exists=.env.setup scripts/setup-appwrite.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name rivendo --branch main",
    "appwrite:security-check": "node --env-file-if-exists=.env.setup scripts/security-check.mjs"
  },
  "dependencies": {
    "appwrite": "^28.1.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "node-appwrite": "^30.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
